{
  "expo": {
    "name": "SmartCane",
    "slug": "smartcane",
    "owner": "sanjeeee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "smartcane",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.smartcane",
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.smartcane",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBkawM_qrgFgVifZu9_B8O6YfqlXNsUbKk"
        }
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/SmartGuide.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SmartGuide.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartCane uses your location to show you and the cane on the map."
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#DC2626",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "googleWebClientId": "184755804059-tna0gg12b8ufkod95vfeqllbqfaqtdm3.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "googleMapsApiKey": "",
      "eas": {
        "projectId": "ebba98e7-76a1-42bd-a627-23ae7008ce0e"
      }
    }
  }
}
